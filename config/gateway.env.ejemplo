# Configuracion del gateway de Mantella.
# Copia este fichero a la raiz del repositorio como .env y editalo.
# Los scripts de instalacion ya lo hacen por ti.

# --- Proveedor del modelo -------------------------------------------------
# openrouter | openai | ollama | lmstudio | koboldcpp | custom
MANTELLA_PROVIDER=openrouter

# Clave de API. Necesaria para openrouter y openai; se ignora en los locales.
# Alternativa: MANTELLA_API_KEY_FILE=C:/ruta/a/GPT_SECRET_KEY.txt
MANTELLA_API_KEY=

# Modelo. Si se deja vacio se usa el que trae el proveedor por defecto.
#   openrouter -> mistralai/mistral-nemo   (barato y rapido, buen rol)
#   openai     -> gpt-4o-mini
#   ollama     -> llama3.1:8b
MANTELLA_MODEL=mistralai/mistral-nemo

# Solo para MANTELLA_PROVIDER=custom (o para apuntar a otro puerto local).
#MANTELLA_BASE_URL=http://localhost:8080/v1

# --- Servidor local -------------------------------------------------------
# Esta es la direccion que hay que poner en el config.ini de Mantella,
# anadiendo /v1 al final: http://localhost:8000/v1
MANTELLA_HOST=127.0.0.1
MANTELLA_PORT=8000

# --- Generacion -----------------------------------------------------------
# Se aplican solo cuando Mantella no manda su propio valor.
MANTELLA_TEMPERATURE=0.8
#MANTELLA_TOP_P=0.9
MANTELLA_MAX_TOKENS=250

# Texto inyectado como primer mensaje de sistema en cada peticion.
# Util para forzar idioma o tono sin tocar los prompts de Mantella.
#MANTELLA_SYSTEM_PREFIX=Responde siempre en espanol, en una sola frase corta.

# --- Adaptacion al motor de voz -------------------------------------------
# El TTS lee literalmente: sin esto pronuncia asteriscos y markdown.
MANTELLA_SANITIZE=true

# Elimina acotaciones de rol: *se cruza de brazos*, (suspira), [mira al suelo].
MANTELLA_STRIP_ACTIONS=true

# Corta la respuesta a N frases. 0 = sin limite.
MANTELLA_MAX_SENTENCES=0

# --- Robustez -------------------------------------------------------------
MANTELLA_TIMEOUT=60
MANTELLA_CONNECT_TIMEOUT=10
MANTELLA_MAX_RETRIES=2
MANTELLA_RETRY_BACKOFF=1.0

# DEBUG muestra cada peticion; util para diagnosticar.
MANTELLA_LOG_LEVEL=INFO
